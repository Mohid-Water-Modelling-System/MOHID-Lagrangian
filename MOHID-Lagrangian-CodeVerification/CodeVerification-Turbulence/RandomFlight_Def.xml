<case>
	<!-- RandomFlight statistical verification: zero-current NetCDF, base particles, 20 km x 20 km, depth 200 m. -->
	<execution>
		<parameters>
			<parameter key="Start" value="2024 01 01 00 00 00" comment="Date of initial instant" units_comment="space delimited ISO 8601 format up to seconds" />
			<parameter key="End" value="2024 01 01 01 00 10" comment="Date of final instant" units_comment="ISO format" />
			<!-- Verification physical duration = 3600 s. Calendar End includes two solver guard steps; analysis uses VTU particle age. -->
			<parameter key="BaseDateTime" value="2024 01 01 00 00 00" comment="Base Date for time stamping purposes. Optional, default = 1950/1/1" units_comment="ISO format" />
			<parameter key="Integrator" value="1" comment="Integration Algorithm 1:Euler, 2:Multi-Step Euler, 3:RK4 (default=1)" />
			<parameter key="Threads" value="1" comment="Computation threads for shared memory computation (default=auto)" />
			<parameter key="NumBlocks" value="1" comment="Number of domain blocks; default equals Threads. Recommend NumBlocks &gt;= Threads." />
			<parameter key="BufferSize" value="7200" comment="Optional parameter. Controls input frequency" units_comment="seconds" />
			<parameter key="OutputWriteTime" value="5" comment="Time out data (1/Hz)" units_comment="seconds" />
			<parameter key="OutputFormat" value="2" comment="Output file format. NetCDF=1; VTK=2 (default=2)" />
		</parameters>
		<variableNaming>
			<file name="ncNamesLibrary.xml" />
		</variableNaming>
		<outputFields>
			<file name="data/outputFields.xml" />
		</outputFields>
	</execution>
	<caseDefinitions>
		<inputData>
			<!-- Hydrodynamic input only. All cells are wet and u=v=w=0; no wind, waves or waterProperties files are required for base tracers. -->
			<inputDataDir name="nc_fields_3D/hydrodynamic" type="hydrodynamic" />
		</inputData>
		<simulation>
			<!-- Entirely wet verification domain; release at its horizontal center and 100 m below the surface. -->
			<resolution dp="1000" units_comment="metres (m)" />
			<timestep dt="5" units_comment="seconds (s)" />
			<BoundingBoxMin x="-0.0898315284119521" y="-0.0898315284119521" z="-200" units_comment="(deg,deg,m)" />
			<BoundingBoxMax x="0.0898315284119521" y="0.0898315284119521" z="0" units_comment="(deg,deg,m)" />
			<VerticalVelMethod value="1" comment="1:From velocity fields, 2:Divergence based, 3:Disabled. Default = 1" />
			<DiffusionMethod value="2" comment="Diffusion method 1:random walk, 2:SullivanAllen. Default = 1" />
			<BathyminNetcdf value="1" comment="bathymetry is a property in the netcdf. 1:true, 0:false (computes from layer depth and openPoints. Default = 1" />
			<RugosityinNetcdf value="0" comment="Rugosity of the seabed is a property in the netcdf. 1:true, 0:false (Default = 0, read from constant input value)" />
			<D50inNetcdf value="0" comment="D50 (median diameter) of the seabed is a property in the netcdf. 1:true, 0:false (Default = 0, read from constant input value)" />
			<SshinNetcdf value="0" comment="Sea surface height is a property in the netcdf. 1:true, 0:false (Default = 0, use zero sea surface height)" />
			<RemoveLandTracer value="0" comment="Remove tracers on land 0:No, 1:Yes. Default = 0" />
		</simulation>
		<sourceDefinitions>
			<source>
				<setsource id="1" name="InstantaneousRelease" />
				<resolution x="1000" y="1000" z="10" units_comment="metres (m)" />
				<!-- The source starts with emission_stack=1; add N-1 on its only active step. -->
				<!-- Verification release: rate_seconds equals dt, with only the first source scheduler step active; emission_stack starts at 1, so N-1 gives exactly N tracers. -->
				<rate_seconds value="5" comment="emission step in seconds. 3600 is a tracer per hour. it should be bigger than dt_simulation" />
				<rate_trcPerEmission value="19999" comment="number of tracers emiited every rate_seconds. 5 is a 5 tracers per rate_seconds" />
				<active start="0" end="7.5" comment="example: start='12.7' end='end'; start='0.0' end='95' " units_comment="seconds (s)" />
				<point x="0" y="0" z="-100" units_comment="(deg,deg,m)" />
			</source>
		</sourceDefinitions>
		<sourceTypes>
			<types>
				<type source="1" type="base" property="passive" comment="Passive base tracers: no buoyancy, settling or resuspension kernels" />
			</types>
			<file name="materialTypes.xml" />
		</sourceTypes>
		<constants>
			<!-- SullivanAllen Random Flight (DiffusionMethod = 2): sigma = VarVelH = 0.1 m/s; eddy lifetime = ConstantMixingLength / sigma = 60 s. -->
			<ConstantMixingLength value="6" comment="Constant horizontal mixing length. Default = 500" units_comment="m:DiffusionMethod=2 (SullivanAllen)" />
			<VarVelHX value="0" comment="Horizontal variance of velocity. Default = 0.2" units_comment="-:DiffusionMethod=2 (SullivanAllen)" />
			<VarVelH value="0.1" comment="base horizontal turbulent velocity. Default = 0.0" units_comment="m/s:DiffusionMethod=2 (SullivanAllen)" />
			<StokesDriftCoeff value="0" comment="Stokes drift coefficient. Default = 0.0" units_comment="-" />
			<WindDragCoeff value="0" comment="Windage coefficient. Default = 0.0" units_comment="" />
			<BeachingStopProb value="0" comment="Probablity of beaching stopping a tracer. Default = 50%" units_comment="%" />
			<BeachingLevel value="-1" comment="Level above which beaching can occur. Default = -3.0" units_comment="m" />
			<AddBottomCell value="0" comment="add openpoint to bottom cell. Default = 0.0." />
		</constants>
	</caseDefinitions>
</case>
