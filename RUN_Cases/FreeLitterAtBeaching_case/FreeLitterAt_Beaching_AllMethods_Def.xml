<?xml version="1.0" encoding="UTF-8" ?>
<!--
    FreeLitterAtBeaching - All beaching method keys reference case
    =============================================================
    This file documents every available beaching-related parameter.
    It is configured to use BeachingMethod=1 (WaterColumn, the default),
    which reproduces the behaviour of FreeLitterAt_Beaching_Def.xml.

    To switch beaching method, change BeachingMethod in any BeachingArea:
      1 = WaterColumn     - beaches when water column < WaterColumnThreshold
      2 = CoastDistance   - beaches when distance to coastline < CoastDistanceThreshold
                            requires a <CoastLine> child element with a polygon file
      3 = InsideBuffer    - beaches on time-scale probability alone (polygon presence only)

    Parameters marked [Method N only] are only used by that method.
    Parameters marked [optional] have documented defaults and can be omitted.
-->
<case>
    <execution>
        <parameters>
            <parameter key="Start" value="2024 01 01 01 00 00" comment="Date of initial instant" units_comment="space delimited ISO 8601 format up to seconds" />
            <parameter key="End"   value="2024 01 05 00 00 00" comment="Date of final instant" units_comment="ISO format" />
            <parameter key="Integrator" value="1" comment="Integration Algorithm 1:Euler, 2:Multi-Step Euler, 3:RK4 (default=1)" />
            <parameter key="Threads" value="1" comment="Computation threads for shared memory computation (default=auto)" />
            <parameter key="OutputWriteTime" value="1000" comment="Time out data (1/Hz)" units_comment="seconds" />
        </parameters>
        <variableNaming>
            <file name="ncNamesLibrary.xml"/>
        </variableNaming>
    </execution>
    <caseDefinitions>
        <inputData>
            <inputDataDir name="hdfFields/hydrodynamic" type="hydrodynamic"/>
            <inputDataDir name="hdfFields/waves" type="waves"/>
            <inputDataDir name="hdfFields/meteo" type="meteorology"/>
        </inputData>
        <simulation>
            <resolution dp="100" units_comment="metres (m)"/>
            <timestep dt="360.0" units_comment="seconds (s)"/>
            <BoundingBoxMin x="-10" y="41.0" z="-5" units_comment="(deg,deg,m)"/>
            <BoundingBoxMax x="-9.99" y="41.03" z="5" units_comment="(deg,deg,m)"/>
            <VerticalVelMethod value="3" comment="1:From velocity fields, 2:Divergence based, 3:Disabled. Default = 1" />
            <BathyminNetcdf value="1" comment="bathymetry is a property in the netcdf. 1:true, 0:false. Default = 1"/>
            <RemoveLandTracer value="0" comment="Remove tracers on land 0:No, 1:Yes. Default = 0" />
            <Beaching>
                <BeachingEnabled value="1" comment="Enable the FreeLitterAt beaching kernel. on=1, off=0"/>

                <!-- ============================================================
                     Example Area using Method 1: WaterColumn (DEFAULT)
                     Beaches when water column at tracer location < WaterColumnThreshold.
                     This is the original method; all previously working cases use this.
                     ============================================================ -->
                <BeachingArea>
                    <BeachAreaID id="1" comment="Beaching area ID. Must be unique and > 0." />

                    <!-- Beach area polygon. Tracers outside this polygon are never beached by this area. -->
                    <polygon>
                        <file name="data/Schematic.xy"/>
                        <verticalBoundingBox min="-5.0" max="5.0"/>
                    </polygon>

                    <CoastType value="1" comment="Integer label for mapping/output purposes only. Must be > 0." />

                    <!-- Beaching method selector.
                         1 = WaterColumn (default - omit this tag for backward compatibility)
                         2 = CoastDistance
                         3 = InsideBuffer -->
                    <BeachingMethod value="1" comment="Beaching method: 1=WaterColumn, 2=CoastDistance, 3=InsideBuffer. Default=1." />

                    <!-- Common to all methods -->
                    <BeachTimeScale value="3600" comment="Time scale for beaching probability: P = 1 - exp(-dt/BeachTimeScale). Default=3600." units_comment="seconds (s)" />
                    <Unbeach value="1" comment="Allow tracers to unbeach after beaching. 1=yes, 0=no. Default=1." />
                    <UnbeachTimeScale value="43200" comment="Time scale for un-beaching probability: P = 1 - exp(-dt/UnbeachTimeScale). Default=3600." units_comment="seconds (s)" />

                    <!-- Run-up effect: adds wave run-up to the water level stored at beach time,
                         used to set the threshold for un-beaching. Requires Hs and Tp fields. -->
                    <RunUpEffect value="1" comment="Add Stockdon (2006) wave run-up to stored BeachedWaterLevel during beaching. 1=yes, 0=no. Default=0." />
                    <RunUpEffectUnbeach value="1" comment="Add wave run-up to current water level during un-beaching comparison. 1=yes, 0=no. Default=0." />
                    <BeachSlope value="0.005" comment="Beach slope (tan beta) for Stockdon run-up formula. Only used when RunUpEffect or RunUpEffectUnbeach=1. Default=0.01." />

                    <!-- [Method 1 only] Water column threshold -->
                    <WaterColumnThreshold value="0.1" comment="[Method 1] Water column below which beaching can occur. Default=0.1." units_comment="metres (m)" />

                    <!-- [Method 2 only] Coast distance parameters.
                         Also requires a <CoastLine> polygon child element (see Area id=2 below). -->
                    <!-- <CoastDistanceThreshold value="500.0" comment="[Method 2] Distance to coastline below which beaching can occur. Default=500." units_comment="metres (m)" /> -->
                    <!-- <CoastDistanceWithTide value="0" comment="[Method 2] Correct effective coast distance for tidal level. 1=yes, 0=no. Default=0." /> -->
                    <!-- <CoastLineLevel value="0.0" comment="[Method 2, CoastDistanceWithTide=1] Vertical level of the coastline in water-level reference frame. Default=0." units_comment="metres (m)" /> -->
                    <!-- <CoastLine>
                             <polygon>
                                 <file name="data/Coastline.xy"/>
                             </polygon>
                         </CoastLine> -->

                    <!-- [optional] Legacy probability multiplier applied before time-scale probability.
                         Kept for backward compatibility. Value between 0 and 1. Default=0 (inactive). -->
                    <Probability value="0.5" comment="[optional] Extra probability multiplier (0-1). Not part of new method logic but read for compatibility." />
                </BeachingArea>

                <!-- ============================================================
                     Example Area using Method 2: CoastDistance (commented out)
                     Beaches when min distance from tracer to <CoastLine> polygon
                     vertices is less than CoastDistanceThreshold metres.
                     Optionally shifts effective coast position with tidal level.
                     ============================================================ -->
                <!--
                <BeachingArea>
                    <BeachAreaID id="2" comment="Beaching area ID." />
                    <polygon>
                        <file name="data/Schematic.xy"/>
                        <verticalBoundingBox min="-5.0" max="5.0"/>
                    </polygon>
                    <CoastType value="1" />
                    <BeachingMethod value="2" comment="CoastDistance method." />
                    <BeachTimeScale value="3600" units_comment="seconds (s)" />
                    <Unbeach value="1" />
                    <UnbeachTimeScale value="43200" units_comment="seconds (s)" />
                    <RunUpEffect value="0" />
                    <RunUpEffectUnbeach value="0" />
                    <BeachSlope value="0.01" />
                    <CoastDistanceThreshold value="500.0" comment="[Method 2] Beach when closer than this to the CoastLine polygon. Default=500." units_comment="metres (m)" />
                    <CoastDistanceWithTide value="0" comment="[Method 2] Apply tide correction to effective distance. 1=yes, 0=no." />
                    <CoastLineLevel value="0.0" comment="[Method 2, CoastDistanceWithTide=1] Coastline vertical level. Required when CoastDistanceWithTide=1." units_comment="metres (m)" />
                    <CoastLine>
                        <polygon>
                            <file name="data/Coastline.xy" comment="Polyline/polygon file defining the coastline geometry."/>
                        </polygon>
                    </CoastLine>
                </BeachingArea>
                -->

                <!-- ============================================================
                     Example Area using Method 3: InsideBuffer (commented out)
                     Beaches on time-scale probability alone when tracer is inside
                     the beach polygon. No water column or distance condition.
                     ============================================================ -->
                <!--
                <BeachingArea>
                    <BeachAreaID id="3" comment="Beaching area ID." />
                    <polygon>
                        <file name="data/Schematic.xy"/>
                        <verticalBoundingBox min="-5.0" max="5.0"/>
                    </polygon>
                    <CoastType value="1" />
                    <BeachingMethod value="3" comment="InsideBuffer method: polygon presence + time-scale probability." />
                    <BeachTimeScale value="3600" units_comment="seconds (s)" />
                    <Unbeach value="1" />
                    <UnbeachTimeScale value="43200" units_comment="seconds (s)" />
                    <RunUpEffect value="0" />
                    <RunUpEffectUnbeach value="0" />
                    <BeachSlope value="0.01" />
                </BeachingArea>
                -->

            </Beaching>
        </simulation>
        <sourceDefinitions>
            <source>
                <setsource id="1" name="Litter_plastic" />
                <rate_seconds value="360" comment="emission step in seconds" />
                <rate_trcPerEmission value="1000" comment="number of tracers emitted every rate_seconds" />
                <active start="0" end="360" units_comment="seconds (s)" />
                <point x="-9.9985" y="41.015" z="2.0" units_comment="(deg,deg,m)"/>
            </source>
        </sourceDefinitions>
        <sourceTypes>
            <types>
                <type source="1" type="plastic" property="bag_1" />
            </types>
            <file name="materialTypes.xml"/>
        </sourceTypes>
        <constants>
            <BeachingLevel value="-5.0" comment="Level above which beaching can occur. Default = -3.0" units_comment="m" />
            <DiffusionCoeff value="50" comment="Horizontal diffusion coefficient. Default = 1.0" units_comment="m2/s" />
        </constants>
    </caseDefinitions>
</case>
