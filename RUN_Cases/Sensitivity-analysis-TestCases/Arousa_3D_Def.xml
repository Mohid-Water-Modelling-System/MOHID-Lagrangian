<?xml version="1.0" encoding="UTF-8" ?>
<case>
	<execution>
		<parameters>
			<parameter key="Start" value="2024 02 23 00 00 00" comment="Date of initial instant" units_comment="space delimited ISO 8601 format up to seconds" />
			<parameter key="End"   value="2024 02 25 00 00 00" comment="Date of final instant" units_comment="ISO format" />
			<!--<parameter key="BaseDateTime" value="1950 01 01 00 00 00" comment="Base Date for time stamping purposes. Optional, default = 1950/1/1" units_comment="ISO format" />-->
			<parameter key="BaseDateTime" value="1950 01 01 00 00 00" comment="Base Date for time stamping purposes. Optional, default = 1950/1/1" units_comment="ISO format" />
			<parameter key="Integrator" value="1" comment="Integration Algorithm 1:Euler, 2:Multi-Step Euler, 3:RK4 (default=1)" />			
			<parameter key="Threads" value="5" comment="Computation threads for shared memory computation (default=auto). Original S8 used 58." />
			<parameter key="BufferSize" value="86400" comment="Optional parameter. Controls input frequency" units_comment="seconds" />			
			<parameter key="OutputWriteTime" value="86400" comment="Write interval: 2 days = run length. Start + end only (paper tables use the last instant)." units_comment="seconds" />
			<parameter key="OutputFormat" value="2" comment="Output file format. NetCDF=1; VTK=2 (default=2)" />
		</parameters>
		<variableNaming>
			<file name="ncNamesLibrary.xml"/>
		</variableNaming>
		<outputFields>
			<file name="data/outputFields.xml"/>
		</outputFields>
