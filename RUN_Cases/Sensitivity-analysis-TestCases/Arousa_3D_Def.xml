		<sourceDefinitions>
			<source>
				<setsource id="1" name="CambadosA1" />
				<resolution x="20" y="20" z="150" units_comment="metres (m)"/>
				<!--<rate_dt value="96" comment="number of timesteps / emission. 1 is every timestep, 5 is every 5 timesteps" />-->
				<rate_seconds value="900" comment="emission step in seconds. 3600 is a tracer per hour. it should be bigger than dt_simulation" />
                <rate_trcPerEmission value="1" comment="number of tracers emiited every rate_seconds. 5 is a 5 tracers per rate_seconds" />	
				<active start="0" end="1800" comment="example: start='12.7' end='end'; start='0.0' end='95' " units_comment="seconds (s)" />
				<!--<rateTimeSeries> 
					<file name="data/Lerez.dat" comment="name of csv file with discharge information (time and rate columns)"/>
					<scale value="0.3" comment="scales the data on the file by this factor (not time)" />
				</rateTimeSeries>-->
				<polygon>
					<file name="data/CambadosA1.kmz"/>
                    <verticalBoundingBox min="-1.0" max="0.0"/>
				</polygon>
				<!-- Bottom emission options (see constant section) -->
				<!--<bottom_emission_depth value="0.5" comment="set source as bottom emission type. 1:true, 0:false" />-->
				<!-- BioFouling options -->
				<!--<biofouling_rate value="0.05" comment="Biofouling growth rate" units_comment="1/day"/>
                <biofouling_start_after value="0.05" comment="Biofouling only starts after x seconds" units_comment="seconds"/>-->
			</source>
	
		</sourceDefinitions>
		<sourceTypes>
			<types>
                <type source="1" type="detritus" property="Kelp_detritus_3_2" comment="" />		
			</types>
			<file name="materialTypes.xml"/>
		</sourceTypes>
		<constants>
			<DiffusionCoeffHorz value="1.0" comment="Horizontal diffusion coefficient. Default = 1.0" units_comment="m2/s" />
			<DiffusionCoeffVert value="1.0e-5" comment="Vertical diffusion coefficient; used directly. Default = 0.000001." units_comment="m2/s" />
			<Rugosity value="0.0025" comment="Rugosity value. Default = 0.0025" units_comment="m2/s" />
			<D50 value="0.0025" comment="D50 (Median diameter of seabed) value. Default = 0.0025" units_comment="m" />
			<D50Density value="2800.0" comment="D50 density (Median diameter of seabed density) value. Default = 2500.0" units_comment="kg/m3" />
			<BeachingLevel value="-3.0" comment="Level above which beaching can occur. Default = -3.0" units_comment="m" />
			<BeachingStopProb value="100" comment="Probablity of beaching stopping a tracer. Default = 50%" units_comment="%" />
			<WindDragCoeff value="0.0" comment="Windage coefficient. Default = 0.0" units_comment="" />

			<!-- Resuspension options -->
			<BedLoadThickness value="0.04" comment="BedLoad thickness. Default = 0.04" units_comment="m" />				
			<ResuspensionProb value="0" comment="Probablity of Resuspension of a tracer. Default = 0%" units_comment="%" />
			<ResuspensionResidenceTime value="8640000.0" comment="Resuspension Residence Time[ResuspensionProb reduces with respect to ResuspensionResidenceTime]. Default = 10*24*60*60" units_comment="sec" />				
			<ResuspensionCriticalShear1 value="0.01" comment="Resuspension Critical Shear 1. Default = 0.10" units_comment="N/m2" />	
			<ResuspensionCriticalShear2 value="0.1" comment="Resuspension Critical Shear 2. Default = 0.45" units_comment="N/m2" />	
			<!--<CriticalShearErosion value="0.00001" comment="Resuspension amplitude velocity factor. Default = 0.40" units_comment="n.u" /> -->			
			
			<!--SullivanAllen diffusion method = 2 options -->
			<!--
			<ConstantMixingLength value="500" comment="Constant horizontal mixing length. Default = 500" units_comment="m:DiffusionMethod=2 (SullivanAllen)" />			
			<VarVelHX value="0.1" comment="Horizontal variance of velocity. Default = 0.2" units_comment="-:DiffusionMethod=2 (SullivanAllen)" />			
			<VarVelH value="0.0" comment="base horizontal turbulent velocity. Default = 0.0" units_comment="m/s:DiffusionMethod=2 (SullivanAllen)" />	
			-->
			
			<!-- Detritus options -->
			
			<ToptBMin value="24.8" comment="minimum temperature of the optimal interval for the Bacteria growth. Default = 24.8" units_comment="degrees" />
            <ToptBMax value="25.1" comment="maximum temperature of the optimal interval for the Bacteria growth. Default = 25.1" units_comment="degrees" />
            <TBMin value="5" comment="minimum tolerable temperature of the interval for the Bacteria growth. Default = 5" units_comment="degrees" />
            <TBMax value="35" comment="maximum tolerable temperature of the interval for the Bacteria growth. Default = 35" units_comment="degrees" />
            <BK1 value="0.9999" comment="constant to control temperature response curve shape. Default = 0.05" units_comment="%" />
            <BK2 value="0.9999" comment="constant to control temperature response curve shape. Default = 0.98" units_comment="%" />
            <BK3 value="0.9999" comment="constant to control temperature response curve shape. Default = 0.98" units_comment="%" />
            <BK4 value="0.9999" comment="constant to control temperature response curve shape. Default = 0.05" units_comment="%" />
			<Lin0_DegradationRate value="0.00000" comment="Lin0_DegradationRate. Default = 0.030/86400" units_comment="Input(1/day).In the code, 1/day converts 1/sec" />	
			<Exp0_DegradationRate value="0.0" comment="Exp0_DegradationRate. Default = 0.14" units_comment=" unit=1" />	
			<Exp1_DegradationRate value="0.0" comment="Exp1_DegradationRate. Default = 0.514/86400" units_comment="Input(1/day).In the code, 1/day converts 1/sec" />	
			<Exp2_DegradationRate value="0.0" comment="Exp2_DegradationRate. Default = 0.040/86400" units_comment="Input(1/day).In the code, 1/day converts 1/sec" />	
			
			<!--<AddBottomCell value="1" comment="add openpoint to bottom cell. Default = 0.0." />-->
			
		</constants>
	</caseDefinitions>
</case>
